# 复制为 .env 后填写。.env 已被 .gitignore 与 .dockerignore 排除，不会进镜像。

# 【必填】MCP 客户端访问令牌。WorkBuddy 的 mcp.json 里 headers.Authorization 用它。
# 生成方式：openssl rand -hex 24
MCP_AUTH_TOKEN=

# environ 后端地址（容器内不能写 localhost）
#
# 走公网（推荐，多处部署都能用）：
ENVIRON_API_BASE=https://app.environ.online/api
#
# 走内网（仅当 MCP 与后端同处内网、且追求低延迟时）：
# ENVIRON_API_BASE=http://192.168.89.36:8081
#
# 注意：base 可以带路径前缀（/api），MCP 会用相对路径拼接，
# 不会把前缀吃掉。

# 后端请求超时（毫秒）
ENVIRON_TIMEOUT_MS=20000

# 对外的 MCP 地址（用于生成给同事的接入配置片段）
MCP_PUBLIC_URL=https://app.environ.online/mcp

# 区分用户的请求头名：每个同事在 mcp.json 里放一个自己的随机串
MCP_CLIENT_HEADER=X-Environ-Client

# 绑定表落盘位置（容器内路径，落在下面的数据卷里）
ENVIRON_BINDINGS_FILE=/data/bindings.json

# 绑定表所在的宿主机目录（数据卷）
ENVIRON_DATA_DIR=./data

# OAuth 存储（客户端注册 / 授权码 / 令牌）落盘位置
ENVIRON_OAUTH_FILE=/data/oauth.json

# OAuth access_token 有效期（秒）与刷新令牌有效期（秒）
OAUTH_ACCESS_TTL=86400
OAUTH_REFRESH_TTL=2592000

# 共享默认绑定。多人共用一套服务时必须保持 false，
# 否则任何人的查询都会落到「最后一个绑定者」的身份上。
ALLOW_DEFAULT_BINDING=false
